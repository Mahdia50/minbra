# ---------------------------------------------------------------------------
#  «مين برّة السالفة» — متغيّرات البيئة
#  انسخ هذا الملف إلى ‎.env.local‎ ثم املأ القيم من لوحة تحكّم Supabase:
#  Project Settings → API
# ---------------------------------------------------------------------------

# رابط المشروع (Project URL) — يبدأ بـ https://
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# المفتاح العام (anon / publishable key) — آمن للاستخدام في المتصفح
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# اختياري: رابط قاعدة البيانات المباشر (Project Settings → Database → Connection string)
# يُستخدم فقط إذا أردت تطبيق ملفات الترحيل عبر psql/سكربت، وليس في التطبيق نفسه.
# SUPABASE_DB_URL=postgresql://postgres:password@db.xxxxxxxxxxxxxxxx.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
#  مهم
#  • لا تضع أبدًا ‎service_role‎ أو مفتاح قاعدة البيانات هنا: كل ما يبدأ بـ
#    NEXT_PUBLIC_ يكون مرئيًا للمتصفح.
#  • يجب تفعيل تسجيل الدخول المجهول في Supabase:
#    Authentication → Sign In / Providers → Anonymous Sign-Ins → Enable
# ---------------------------------------------------------------------------
